{
  "name": "agentic-booking",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Agentic Booking - Phase 1 Multi-Platform Browser Automation Lab (mock sites only)",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:irctc": "pnpm --filter mock-irctc dev",
    "dev:redbus": "pnpm --filter mock-redbus dev",
    "dev:bookmyshow": "pnpm --filter mock-bookmyshow dev",
    "dev:hub": "tsx apps/automation-hub/server.ts",
    "start:phase1": "pnpm dev:bookmyshow & pnpm dev:redbus & pnpm dev:hub",
    "build": "pnpm -r build",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ws": "^8.22.0"
  }
}